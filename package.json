{
  "name": "music-player-dock", "version": "1.2.6", "private": true,
  "description": "A quiet Windows music island", "author": "MusicPlayerDock", "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs", "preview": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit", "typecheck:desktop":"node node_modules/typescript/bin/tsc -p tsconfig.desktop.json", "test": "node --test tests/*.test.mjs", "validate:shaders":"node scripts/validate-glass-shaders.mjs",
    "build:ui": "npm run typecheck && node node_modules/vite/bin/vite.js build && node scripts/build-main.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:ui && npm run build:native",
    "start": "node scripts/start.mjs", "dist": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {"glisse": "0.5.0", "react": "19.3.1", "react-dom": "19.3.1", "lucide-react": "1.70.0"},
  "devDependencies": {"@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/node": "^22.0.0", "typescript": "7.0.2", "vite": "7.3.8", "electron": "41.2.1", "esbuild": "0.28.2"}
}
